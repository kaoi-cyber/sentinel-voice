# Copy this file to .env.local and fill in your own values.
# .env.local is ignored by git — never commit real keys.

# ElevenLabs (voice). Get a key at elevenlabs.io → Developers → API Keys.
ELEVENLABS_API_KEY=
# Optional overrides
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# ELEVENLABS_STT_MODEL=scribe_v2

# Tokenomist (tokenomics data). Key from your Tokenomist dashboard. Server-side only.
TOKENOMIST_API_KEY=
